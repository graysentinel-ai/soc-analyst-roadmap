<script>
(function () {

    const STORAGE_KEY = "graysentinel_module08_progress";

    const checkboxes = document.querySelectorAll(".module-check");
    const progressFill = document.getElementById("progressFill");
    const progressText = document.getElementById("progressText");

    function loadProgress() {

        let saved = {};

        try {
            saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
        } catch (error) {
            saved = {};
        }

        checkboxes.forEach(function (checkbox) {
            checkbox.checked = saved[checkbox.dataset.id] === true;
        });

        updateProgress();
    }

    function updateProgress() {

        const completed = Array.from(checkboxes)
            .filter(function (checkbox) {
                return checkbox.checked;
            }).length;

        const percentage = Math.round((completed / 8) * 100);

        progressFill.style.width = percentage + "%";

        progressText.textContent =
            completed + " of 8 completed (" + percentage + "%)";

        const saved = {};

        checkboxes.forEach(function (checkbox) {
            saved[checkbox.dataset.id] = checkbox.checked;
        });

        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(saved));
        } catch (error) {
            console.warn("Progress could not be saved locally.");
        }
    }

    checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener("change", updateProgress);
    });

    loadProgress();

    const answers = {
        q1: "b",
        q2: "a",
        q3: "c",
        q4: "b",
        q5: "a",
        q6: "b",
        q7: "c",
        q8: "d"
    };

    const quizForm = document.getElementById("quizForm");
    const quizResult = document.getElementById("quizResult");

    quizForm.addEventListener("submit", function (event) {

        event.preventDefault();

        let score = 0;
        let unanswered = 0;

        Object.keys(answers).forEach(function (question) {

            const selected = quizForm.querySelector(
                'input[name="' + question + '"]:checked'
            );

            if (!selected) {
                unanswered++;
                return;
            }

            if (selected.value === answers[question]) {
                score++;
            }

        });

        if (unanswered > 0) {

            quizResult.style.display = "block";
            quizResult.textContent =
                "Please answer all 8 questions before submitting.";

            return;
        }

        const percentage = (score / 8) * 100;

        quizResult.style.display = "block";

        quizResult.innerHTML =
            "<h3>Assessment Result</h3>" +
            "<p><strong>Score:</strong> " + score + "/8</p>" +
            "<p><strong>Percentage:</strong> " + percentage + "%</p>" +
            "<p>" +
            (score >= 6
                ? "Good work. Review your practical tasks and continue strengthening your detection engineering skills."
                : "Review the learning material and attempt the assessment again.") +
            "</p>";

        quizResult.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

    });

})();
</script>

